          "source": {
            "type": "AzurePostgreSqlSource",
            "query": {
              "value": "@concat('WITH boundary AS (SELECT COALESCE(MAX(updated_at), TIMESTAMPTZ ''' , activity('Lookup_Current_Watermarks').output.firstRow.customers_watermark, ''' ) AS new_watermark FROM public.customers) SELECT boundary.new_watermark::text AS new_watermark, COUNT(t.customer_id)::bigint AS expected_rows FROM boundary LEFT JOIN public.customers t ON t.updated_at > TIMESTAMPTZ ''' , activity('Lookup_Current_Watermarks').output.firstRow.customers_watermark, ''' AND t.updated_at <= boundary.new_watermark GROUP BY boundary.new_watermark')",
              "type": "Expression"
            },
            "queryTimeout": "00:10:00",
            "partitionOption": "None"
          },
          "dataset": {
