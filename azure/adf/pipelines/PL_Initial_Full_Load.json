          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": false
        },
        "userProperties": [],
        "typeProperties": {
          "source": {
            "type": "AzurePostgreSqlSource",
            "query": "SELECT COUNT(*)::bigint AS source_rows FROM public.customers",
            "queryTimeout": "00:10:00",
            "partitionOption": "None"
