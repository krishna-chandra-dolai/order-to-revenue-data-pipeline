        "name": "Validate_Full_Counts_Then_Initialize_Watermarks",
        "type": "IfCondition",
        "typeProperties": {
          "expression": {
            "type": "Expression",
            "value": "@and(and(and(equals(int(activity('Copy_Customers_To_Raw').output.rowsCopied), int(activity('Lookup_Customers_Full_Count').output.firstRow.source_rows)), equals(int(activity('Copy_Products_To_Raw').output.rowsCopied), int(activity('Lookup_Products_Full_Count').output.firstRow.source_rows))), equals(int(activity('Copy_Orders_To_Raw').output.rowsCopied), int(activity('Lookup_Orders_Full_Count').output.firstRow.source_rows))), equals(int(activity('Copy_Payments_To_Raw').output.rowsCopied), int(activity('Lookup_Payments_Full_Count').output.firstRow.source_rows)))"
          },
          "ifFalseActivities": [
            {
              "dependsOn": [],
              "name": "Fail_Full_Load_Row_Count_Validation",
              "type": "Fail",
              "typeProperties": {
                "errorCode": "FULL_LOAD_ROW_COUNT_MISMATCH",
                "message": "One or more full-load source counts did not match Copy rowsCopied; initial watermarks were not written."
              },
              "userProperties": []
            }
          ],
          "ifTrueActivities": [
            {
              "dependsOn": [],
              "inputs": [
                {
                  "parameters": {},
                  "referenceName": "DS_PG_Query",
                  "type": "DatasetReference"
                }
              ],
              "name": "Write_Initial_Watermarks",
              "outputs": [
                {
                  "parameters": {
                    "fileName": "watermarks.csv",
                    "folderPath": "_control"
                  },
                  "referenceName": "DS_ADLS_Watermark_Control",
                  "type": "DatasetReference"
                }
              ],
              "policy": {
                "retry": 0,
                "retryIntervalInSeconds": 30,
                "secureInput": false,
                "secureOutput": false,
                "timeout": "0.12:00:00"
              },
              "type": "Copy",
              "typeProperties": {
                "enableStaging": false,
                "sink": {
                  "formatSettings": {
                    "fileExtension": ".csv",
                    "quoteAllText": true,
                    "type": "DelimitedTextWriteSettings"
                  },
                  "storeSettings": {
                    "type": "AzureBlobFSWriteSettings"
                  },
                  "type": "DelimitedTextSink"
                },
                "source": {
                  "partitionOption": "None",
                  "query": {
                    "type": "Expression",
                    "value": "@concat('SELECT (SELECT MAX(updated_at)::text FROM public.customers) AS customers_watermark, (SELECT MAX(updated_at)::text FROM public.products) AS products_watermark, (SELECT MAX(updated_at)::text FROM public.orders) AS orders_watermark, (SELECT MAX(updated_at)::text FROM public.payments) AS payments_watermark, ''' , pipeline().RunId, '''::text AS last_successful_run_id, clock_timestamp()::text AS completed_at')"
                  },
                  "queryTimeout": "00:10:00",
                  "type": "AzurePostgreSqlSource"
                }
              },
              "userProperties": []
            }
          ]
        },
